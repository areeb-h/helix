# Feature probe — confirm the new syntax/features compile and behave.

# range literal + closures + fusion
print((0..10).filter(it % 2 == 0).map(it * it).reduce(0, (a, x) => a + x))

# higher-order fn + lexical closure
fn adder(n) = (x => x + n)
add5 = adder(5)
print(add5(37))

# pattern matching: literals, binding, guard, or-pattern, tuple, record
fn classify(n) = match n {
  0 => "zero",
  1 | 2 | 3 => "small",
  x if x > 100 => "big",
  x => "mid"
}
print(classify(0))
print(classify(2))
print(classify(500))
print(classify(42))

# try → record {ok, value, error}, destructured by match
result = match try (10 / 0) {
  {ok: true, value: v} => v,
  {ok: false} => -1
}
print(result)

# DNA + IUPAC + kmer spectrum
seq = dna("ATGCGATACGCTTGA")
print(seq.gc_content())
print(seq.reverse_complement())
print(seq.kmers(3).frequencies())
print(seq.kmer_counts(3))

# array unique / frequencies / top
xs = [3, 1, 1, 2, 3, 3]
print(xs.unique())
print(xs.frequencies())

# in-memory dataframe constructor + @column verbs
df = dataframe({gene: ["BRCA1", "BRCA1", "TP53"], expr: [10.0, 20.0, 30.0]})
print(df.group(@gene).mean(@expr))
