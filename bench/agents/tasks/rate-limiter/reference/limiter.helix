## A token bucket: `capacity` tokens, one more every `refill_ms`.
export fn new(capacity, refill_ms) = {capacity: capacity, refill_ms: refill_ms, tokens: capacity, since: missing}

## Ask for one token at `now_ms`; returns (limiter, allowed).
export fn allow(l, now_ms) = do {
  since = l.since ?? now_ms
  earned = (now_ms - since) // l.refill_ms
  tokens = l.tokens + earned
  full = tokens >= l.capacity
  t = if full then l.capacity else tokens
  start = if full then now_ms else since + earned * l.refill_ms
  ok = t > 0
  ({capacity: l.capacity, refill_ms: l.refill_ms, tokens: if ok then t - 1 else t, since: start}, ok)
}
