import stats.{mean, median, spread}

fn test_odd_median() = assert_eq(median([3, 1, 2]), 2)
fn test_spread() = assert_eq(spread([4, 9, 1]), 8)
fn test_empty_is_missing() = assert(median([]).is_missing())
fn test_even_median() = assert_eq(median([4, 1, 3, 2]), 2.5)
fn test_mean_is_not_rounded() = assert_eq(mean([1, 2]), 1.5)
