# std.seq — sequence-analysis helpers over the built-in DNA operations.
#
# Part of the Helix standard library (see std/stats.helix). Import it from anywhere on
# the search path:
#
#   import std.seq as seq
#   seq.mean_gc(reads.map(r => r.seq))
#
# The helpers compose the DNA methods (`gc_content`, `length`, …) and the array verbs,
# so they inherit the engine's behavior and stay one line each.

# AT content: the fraction of adenine/thymine bases, the complement of GC content.
fn at_content(s) = 1.0 - s.gc_content()

# Mean GC content across a collection of sequences (e.g. the reads of a FASTQ file).
fn mean_gc(seqs) = seqs.map(s => s.gc_content()).mean()

# Total length of a collection of sequences, in bases.
fn total_length(seqs) = seqs.map(s => s.length()).sum()
