# The v0.14.0 release notes, as a program.
#
# Every line below is a claim the changelog makes, quoted or taken from its examples. The
# expectations in `v0.14.0-claims.expected` are authored BY HAND from the notes — capturing
# them from a binary would prove only that the binary agrees with itself. What only a window,
# a browser or a Rust compiler can show (no listening socket, axe-core, `helix emit rust`'s
# output compiling and passing its own tests, a built app's bundle) is pinned by `tests/cli.rs`,
# `tests/ui/*.cjs` and `tests/ui/window.sh`; "`a <b` still compares" is pinned in `src/markup.rs`,
# because `helix fmt` spaces it; the cells here are the claims a program can check.
# A release is built with default features, so nothing here needs `desktop`.

import std.ui
import std.model

# --- Added (ADR 0065): "`model.explore(init, inputs, step, check)` visits every state a rule can
# --- reach over a finite set of inputs, checks a property on every step, and returns a shortest
# --- failing sequence when one breaks." A counter that wraps at 3: states 0, 1, 2.
fn wrap_step(n, input) = {state: if input == "up" then (n + 1) % 3 else 0, out: missing}
fn under_three(before, input, after, out) = if after < 3 then "" else "reached {after}"
ok = model.explore(0, ["up", "reset"], wrap_step, under_three)
print("{ok.states} {ok.transitions} {ok.failure.is_missing()}")
print(model.explain(ok.failure))
# The same counter without the wrap breaks at 3, and the shortest path there is three "up"s.
fn grow_step(n, input) = {state: if input == "up" then n + 1 else 0, out: missing}
bad = model.explore(0, ["reset", "up"], grow_step, under_three)
print(bad.failure.path)
print(model.explain(bad.failure))

# --- Added (ADR 0064): "`ui.tokens(design, "gtk" | "css" | "json", mode)` exports a design's
# --- colours, sizes and springs, with how many contrast pairs were checked."
d = ui.design({seed: "#4f46e5"})
gtk = ui.tokens(d, "gtk", "dark")
print(gtk.starts_with("/* Generated by Helix (ui.tokens, ADR 0064). "))
print(gtk.contains(", 0 below WCAG. */"))
print(gtk.split("\n").drop(1).all((l) => l.starts_with("@define-color hx_") and l.ends_with(";")))
j = ui.tokens(d, "json", "light").parse_json()
print("{j.mode} {j.contrast.checked > 0} {j.contrast.failing.count()}")
print(ui.tokens(d, "css").contains(":root {{"))

# --- Added: "Several sort keys: `sort_by(p => (p.team, -p.score))`. `sort`, `min` and `max` now
# --- order tuples as `<` always has, so `xs.enumerate().sort()` works."
people = [{team: "b", score: 3}, {team: "a", score: 1}, {team: "a", score: 7}]
print(people.sort_by((p) => (p.team, -p.score)).map((p) => "{p.team}{p.score}"))
print([(2, "b"), (1, "z"), (1, "a")].sort())
print([(2, "b"), (1, "z"), (1, "a")].min())
print(["c", "a", "b"].enumerate().map((t) => (t[1], t[0])).sort().map((t) => t[1]))

# --- Added: "array spread `[head, ...rest]`".
rest = [2, 3]
print([1, ...rest, 4])

# --- Added (ADR 0061): "`<li class="row" click="open" value={f.id}>{f.name}</li>` is the record
# --- `ui.el` builds".
f = {id: 7, name: "notes"}
li = <li class="row" click="open" value={f.id}>{f.name}</li>
print(li == ui.el("li", {class: "row", click: "open", value: 7}, [f.name]))
# "A child may be a string": it renders as the text node `ui.text` makes.
print(view_html(li) == view_html(ui.el("li", {class: "row", click: "open", value: 7}, [ui.text("notes")])))
# "`aria-label` goes into `aria`, and other attributes go into `attrs`. A bare attribute is `true`".
print(view_html(<button aria-label="Close" disabled>x</button>))
# "`{price:.2f}` inside markup text formats the value, as it does in a string."
price = 3.5
print(view_html(<p>{price:.2f}</p>))
# "Markup kept two spaces between holes (`{a} {b}`)" — now one.
a = "x"
b = "y"
print(view_html(<p>{a} {b}</p>))
# "`class:done={it.done}` adds a class while a condition holds".
print(view_html(<li class="row" class:done={true}>t</li>))
# "`{if busy then <Spinner />}` needs no `else` inside markup" — nothing renders when false.
busy = false
print(view_html(<div>{if busy then <b>wait</b>}</div>))
# "`{items.map(<li>{it}</li>)}` loops without a lambda".
items = ["p", "q"]
print(view_html(<ul>{items.map(<li>{it}</li>)}</ul>))
# "A capitalised tag calls any function by its parameter names": `<TodoItem label="x" done />`
# calls `todo_item`.
fn todo_item(label, done) = <li class:done={done}>{label}</li>
print(view_html(<TodoItem label="x" done />))

# --- Added: "`class` takes a list, as `clsx` does." `missing` and `false` entries drop out.
print(view_html(ui.el("p", {class: ["a", missing, false, "b"]}, [])))

# --- Added: "`ui.Segmented`, `ui.RadioGroup` and `ui.Chips` take plain strings
# --- (`options={["a", "b"]}`) … Plain strings used to render as letters."
seg = view_html(ui.segmented("s", "View", "list", ["list", "grid"], "view"))
print(seg.contains(">list<") and seg.contains(">grid<"))

# --- Added (ADR 0060): utility classes — "the runtime writes the CSS for exactly the classes the
# --- view uses"; "Bracketed values pass a strict whitelist".
print(view_classes(ui.el("div", {class: "p-4 rounded-xl"}, [ui.el("span", {class: "text-muted"}, [])])))
print(utility_css(["p-4"]).contains("padding"))
print(utility_css(["bg-[url(javascript:alert(1))]"]) == "")
# "`before:`/`after:` accept only empty content (`content-['']`), so a class can never put text
# on the page."
print(utility_css(["before:content-['']"]).contains("content"))
print(utility_css(["before:content-['hi']"]) == "")

# --- Added: "`ui.palette_matches` (prefix, then word start, then letters in order)".
cmds = [{label: "Open recent"}, {label: "Reopen"}, {label: "Go to folder"}, {label: "Copy path"}]
print(ui.palette_matches("op", cmds).map((x) => x.label))

# --- Added (ADR 0056): "Each text colour is moved just far enough to reach WCAG AA on every
# --- surface it sits on." Every pair the report lists passes.
print(ui.contrast_report(d).all((p) => p.ok))
# "an inner corner is its container's radius minus the padding between them".
g = ui.geometry("soft", "comfortable")
print(g.in_card == g.card - g.pad_card)

# --- Added: "`has_feature("desktop")` answers; it was missing from the list." A release is built
# --- without it.
print(has_feature("desktop"))
