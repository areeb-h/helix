# std.ui on the data apps really have: empty, missing, NaN, infinite, zero. A view that raises
# on one of these undoes the event that led to it, and one at start-up stops the app — so
# each of these must draw, and draw something honest.
import std.ui

fn has(node, s) = ui.render(node).contains(s)
fn draws(name, f) = do {
  r = try f()
  print("{name}: {if r.ok then "draws" else "raises: {r.error}"}")
}

# Numbers that are not numbers.
df = dataframe({x: [1.5, nan, inf, -inf, 1234.5], y: ["a", "b", "c", "d", "e"]})
t = ui.render(ui.data_table("t", df, 0, "s", "T"))
print([t.contains(">NaN<"), t.contains(">∞<"), t.contains(">−∞<"), t.contains(">1234.5<")])
draws("data_table offset NaN", () => ui.data_table("t", df, nan, "s", "T"))
draws("data_table offset 1e30", () => ui.data_table("t", df, 1.0e30, "s", "T"))
draws("data_table row height 0", () => ui.data_table("t", df, 40, "s", "T", row_height: 0))
draws("line_chart with NaN and ∞", () => ui.line_chart("L", [{name: "a", xs: [1, 2, 3, 4], ys: [1.0, nan, inf, 2.0]}]))
draws("scatter_chart with NaN", () => ui.scatter_chart("S", [1.0, nan, 3.0], [nan, 2.0, 3.0]))
draws("bar_chart with ∞", () => ui.bar_chart("B", ["a", "b"], [inf, 2.0]))
print(ui.render(ui.scatter_chart("S", [1.0, nan, 3.0], [1.0, 2.0, 3.0])).split("<circle").count() - 1)
draws("bar_chart all NaN", () => ui.bar_chart("B", ["a"], [nan]))

# Nothing yet, and nothing of nothing.
draws("sparkline []", () => ui.sparkline([], "S"))
draws("sparkline [NaN]", () => ui.sparkline([nan], "S"))
draws("stat_tile with an empty series", () => ui.stat_tile("Sales", 0, series: []))
print(has(ui.sparkline([], "Visits"), "Visits (no data)"))
draws("ring 0 of 0", () => ui.ring("Done", 0, 0))
print(has(ui.ring("Done", 0, 0), "Done: 0%"))
draws("progress 0 of 0", () => ui.progress("Done", 0, 0))

# A field with no value yet is empty.
print([has(ui.text_input("a", "A", missing, "m"), "missing"), has(ui.search_field("q", "Q", missing, "m"), "missing"), has(ui.textarea("b", "B", missing, "m"), "missing")])

# A tab whose id has a space: each ARIA reference names one element.
tb = ui.render(ui.tabs("t", "a b", [{id: "a b", label: "A", content: ui.text("1")}, {id: "a_b", label: "B", content: ui.text("2")}], "m"))
print([tb.contains("aria-controls=\"t-panel-a_32_b\""), tb.contains("id=\"t-panel-a_32_b\""), tb.contains("id=\"t-panel-a_95_b\"")])

# A grey seed has no hue to keep: every grey gives the same graphite accent, and black too.
greys = ["#808080", "#ffffff", "#010101", "#000000"].map((s) => ui.design({seed: s}).light.get("accent"))
print([greys.unique().count(), greys[0]])

# Timers are checked where they are made.
draws("every(0)", () => ui.every(0, "t"))
draws("every(\"x\")", () => ui.every("x", "t"))
draws("every(1000, 5)", () => ui.every(1000, 5))
print(ui.every(250, "tick"))
