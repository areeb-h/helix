# Gestures and structure (std.ui): what each component promises in its markup, and what the
# helpers do with what the page sends. The dragging itself is the page's; here is everything
# the app decides, which replays without a browser and agrees on all three engines.
import std.ui

fn has(node, s) = ui.render(node).contains(s)

# A split view: the divider is a focusable separator that says where it is and which way it
# moves, and the size is kept in bounds however it arrives.
sv = ui.split_view(ui.text("left"), ui.text("right"), 900, "side", min: 160, max: 400)
print([has(sv, "role=\"separator\""), has(sv, "data-resize=\"side\""), has(sv, "aria-valuenow=\"400\""), has(sv, "aria-orientation=\"vertical\""), has(sv, "flex-basis: 400px")])
print([ui.resized(250, 160, 400), ui.resized(12, 160, 400), ui.resized(1.0e9, 160, 400), ui.resized("wide", 160, 400, 220), ui.resized(0.0 / 0.0, 160, 400, 220), ui.resized(250.6, 160, 400)])
print(has(ui.split_view(ui.text("a"), ui.text("b"), 200, "h", axis: "y"), "aria-orientation=\"horizontal\""))

# A sortable list: the container names the message, each row is keyed and has a labelled grip,
# and the keyboard's way is described to a screen reader.
items = [{key: "a", title: "Alpha"}, {key: "b", title: "Beta"}, {key: "c", title: "Gamma"}]
st = ui.render(ui.sortable("tasks", "Tasks", items, "order"))
print([st.contains("data-reorder=\"order\""), st.contains("data-key=\"b\""), st.contains("aria-label=\"Move Beta\""), st.contains("data-drag-handle=\"true\""), st.contains("aria-describedby=\"tasks-how\""), st.contains("id=\"tasks-how\"")])

# Applying a move: only one that fits the list as it is.
keys = (xs) => xs.map((x) => x.key).join("")
print(keys(ui.reordered(items, {key: "c", from: 2, to: 0})))
print(keys(ui.reordered(items, {key: "a", from: 0, to: 2})))
print(keys(ui.reordered(items, {key: "a", from: 1, to: 0})))
print(keys(ui.reordered(items, {key: "a", from: 0, to: 9})))
print(keys(ui.reordered(items, {key: "a", from: -1, to: 0})))
print(keys(ui.reordered(items, "c to the top")))
print(keys(ui.reordered(items, {key: "a", from: "0", to: 1})))
print(ui.reordered(["x", "y", "z"], {key: "z", from: 2, to: 1}, (k) => k))

# A disclosure is always in the page; closed, its body is inert.
print([has(ui.disclosure("d", "More", false, "t", [ui.text("x")]), "inert=\"\""), has(ui.disclosure("d", "More", true, "t", [ui.text("x")]), "inert"), has(ui.disclosure("d", "More", true, "t", [ui.text("x")]), "aria-expanded=\"true\" aria-controls=\"d-body\"")])
print(ui.render(ui.accordion([{id: "a", title: "A", content: ui.text("1")}, {id: "b", title: "B", content: ui.text("2")}], ["b"], "t")).split("disclosure open").count() - 1)

# A tree: levels, expanded states, selection, and one row in the Tab order.
nodes = [{key: "src", label: "src", children: [{key: "src/a", label: "a.helix", icon: "code"}]}, {key: "doc", label: "doc", expandable: true}, {key: "README", label: "README"}]
t1 = ui.render(ui.tree("t", "Files", nodes, ["src"], "src/a", "tog", "sel"))
print([t1.contains("role=\"tree\""), t1.contains("aria-level=\"2\""), t1.split("aria-expanded=\"true\"").count() - 1, t1.split("aria-expanded=\"false\"").count() - 1, t1.split("tabindex=\"0\"").count() - 1, t1.contains("aria-selected=\"true\"")])
t2 = ui.render(ui.tree("t", "Files", nodes, [], "src/a", "tog", "sel"))
print([t2.contains("a.helix"), t2.split("tabindex=\"0\"").count() - 1, t2.split("id=\"t-src\"")[1].split(">")[0].contains("aria-expanded=\"false\" aria-selected=\"false\" tabindex=\"0\"")])
print(ui.render(ui.tree("t", "Empty", [], [], missing, "tog", "sel")))

# A popover: a dialog anchored to its button, there only while open, focus moved into it.
print([has(ui.popover("p", "Filter", false, "pop", ui.text("x")), "role=\"dialog\""), has(ui.popover("p", "Filter", true, "pop", ui.text("x")), "role=\"dialog\""), has(ui.popover("p", "Filter", true, "pop", ui.text("x")), "aria-haspopup=\"dialog\" aria-expanded=\"true\" aria-controls=\"p-pop\""), has(ui.popover("p", "Filter", true, "pop", ui.text("x")), "autofocus")])

# Work under way: a spinner and a bar with no value are progress bars with no value.
print([ui.render(ui.spinner("Syncing")), ui.render(ui.progress("Indexing", missing))])

# Swipes: a toast thrown sideways sends what its close button sends; a sheet pulled down by its
# grabber sends its close.
ts = ui.render(ui.toasts([{id: 7, text: "Saved"}], "dismiss"))
print([ts.contains("data-drag=\"dismiss\" data-drag-axis=\"x\" data-drag-commit=\"80\""), ts.contains("data-value=\"7\"")])
sh = ui.render(ui.sheet("s", true, "Share", [ui.text("x")], "close"))
print([sh.contains("data-drag=\"close\" data-drag-axis=\"down\" data-drag-commit=\"96\""), sh.contains("class=\"grabber-zone\" data-drag-handle=\"true\" aria-hidden=\"true\"")])

# A navigation stack: only the top two screens are drawn, the lower one inert and hidden from
# screen readers; the top one is pushed in, swiped back from its edge, and names where back goes.
screens = [{key: "a", title: "Inbox", content: ui.text("list")}, {key: "b", title: "Message", content: ui.text("one")}, {key: "c/d", title: "Reply", content: ui.text("two")}]
sk = ui.render(ui.stack("nav", screens, "back"))
print([sk.split("class=\"stack-screen").count() - 1, not sk.contains("Inbox</h2>"), sk.contains("aria-label=\"Back to Message\""), sk.contains("data-key=\"nav-c_47_d\""), sk.contains("inert=\"\""), sk.contains("data-enter=\"push\"")])
one = ui.render(ui.stack("nav", screens.take(1), "back"))
print([one.contains("stack-back"), one.contains("data-drag"), one.contains("data-enter")])
print([ui.render(ui.large_title("Files")), ui.render(ui.toolbar_title("Files"))])

# Swipe rows: the app decides which row is open from where it was let go and how fast.
print([ui.swiped("", {msg: "s", value: "a", drag: {dx: -120, dy: 0, vx: 0, vy: 0}}, 2), ui.swiped("", {msg: "s", value: "a", drag: {dx: -30, dy: 0, vx: 0, vy: 0}}, 2), ui.swiped("", {msg: "s", value: "a", drag: {dx: -30, dy: 0, vx: -900, vy: 0}}, 2)])
print([ui.swiped("a", {msg: "s", value: "a", drag: {dx: 60, dy: 0, vx: 0, vy: 0}}, 2), ui.swiped("a", {msg: "s", value: "a", drag: {dx: 10, dy: 0, vx: 0, vy: 0}}, 2), ui.swiped("a", {msg: "s", value: "a"}, 2), ui.swiped("a", {msg: "s", value: "b", drag: {dx: -200, dy: 0, vx: 0, vy: 0}}, 2), ui.swiped("a", {msg: "s", value: "b", drag: "nonsense"}, 2)])
sr = ui.render(ui.swipe_row("a", ui.text("Row"), [{label: "Delete", msg: "del", value: "a", icon: "trash", tone: "danger"}], "a", "s"))
print([sr.contains("swipe-row open"), sr.contains("data-drag=\"s\" data-drag-axis=\"x\""), sr.contains("--n: 1"), sr.contains("swipe-act danger")])

# A board: a move between columns, within one, and ones that do not fit.
cols = [{id: "a", title: "A", items: [{key: "1", title: "one"}, {key: "2", title: "two"}]}, {id: "b", title: "B", items: [{key: "3", title: "three"}]}]
show = (cs) => cs.map((c) => "{c.id}:{c.items.map((x) => x.key).join("")}").join(" ")
print(show(ui.moved_between(cols, {key: "1", from: 0, to: 1, from_list: "a", to_list: "b"})))
print(show(ui.moved_between(cols, {key: "1", from: 0, to: 0, from_list: "a", to_list: "b"})))
print(show(ui.moved_between(cols, {key: "1", from: 0, to: 9, from_list: "a", to_list: "b"})))
print(show(ui.moved_between(cols, {key: "2", from: 1, to: 0, from_list: "a", to_list: "a"})))
print(show(ui.moved_between(cols, {key: "3", from: 0, to: 0, from_list: "a", to_list: "b"})))
print(show(ui.moved_between(cols, {key: "1", from: 0, to: 0, from_list: "a", to_list: "nowhere"})))
print(show(ui.moved_between(cols, "drop it")))
bd = ui.render(ui.board("plan", "Plan", cols, "move"))
print([bd.contains("data-reorder=\"move\" data-reorder-group=\"plan\""), bd.contains("data-value=\"b\""), bd.contains("aria-describedby=\"plan-how\""), bd.contains("id=\"plan-how\"")])

# A carousel: slides, buttons and dots, the first marked current; the app named for changes.
cr = ui.render(ui.carousel("tour", "Tour", [ui.text("a"), ui.text("b")], "slide"))
print([cr.split("carousel-slide").count() - 1, cr.contains("data-carousel=\"slide\""), cr.contains("data-scroll-step=\"-1\""), cr.contains("aria-label=\"Slide 2\""), cr.contains("aria-current=\"true\""), cr.contains("aria-roledescription=\"carousel\"")])

# A symbol replays its effect when its trigger changes: a new key, so a new node.
print([ui.render(ui.symbol("bell", "bounce", 1)).contains("data-key=\"sym-bell-1\" data-enter=\"bounce\""), ui.render(ui.symbol("heart", "swap", 0)).contains("data-enter=\"symbol\" data-exit=\"fade\"")])

# Charts read by pointing: a band per point, one in the Tab order, each saying its values.
lc = ui.render(ui.line_chart("L", [{name: "a", xs: [1, 2, 3], ys: [1.0, 2.0, 3.0]}]))
print([lc.split("class=\"band\"").count() - 1, lc.split("tabindex=\"0\"").count() - 1, lc.contains("role=\"group\""), lc.contains("aria-label=\"2.0: a 2.00\"")])
many = ui.render(ui.line_chart("L", [{name: "a", xs: range(0, 200).map((i) => i * 1.0), ys: range(0, 200).map((i) => i * 1.0)}]))
print([many.contains("class=\"band\""), many.contains("role=\"img\"")])
bc = ui.render(ui.bar_chart("B", ["x", "y"], [3, 5]))
print([bc.split("class=\"band\"").count() - 1, bc.contains("aria-label=\"y: 5\"")])
