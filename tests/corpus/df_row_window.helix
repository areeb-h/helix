# `slice` and `tail` — the row window a chunked store needs and `head` alone cannot give.
df = dataframe({i: [0, 1, 2, 3, 4], s: ["a", "b", "c", "d", "e"]})
print(df.head(2).column("s"))
print(df.tail(2).column("s"))
print(df.slice(1, 3).column("s"))

# CLAMPED, not refused. A window running off the end is how the last chunk of a scan reads,
# and erroring would force the caller to materialize the row count first.
print(df.slice(3, 99).column("s"))
print(df.slice(99, 3).count())
print(df.slice(0, 0).count())
print(df.tail(99).count())
print(df.head(99).count())

# The three verbs agree where they overlap.
print(df.slice(0, 2).column("s") == df.head(2).column("s"))
print(df.slice(3, 2).column("s") == df.tail(2).column("s"))

# It composes with a query, and slicing after filtering is not the same as before it —
# which is the whole point of having an offset.
print(df.where(@i > 1).slice(0, 2).column("s"))
print(df.slice(0, 2).where(@i > 1).column("s"))
