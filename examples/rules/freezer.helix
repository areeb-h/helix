## Freezes apps you can't see (mobile-os ADR 0011): an app hidden for a while is frozen with
## systemd's cgroup freezer, and thawed the moment it comes back. These are the rules only —
## which app to freeze, thaw, or give a small CPU share, and when — with no system calls: the
## shell applies the actions. `helix emit rust` turns this file into the shell's `Policy`.
##
## Times are integer milliseconds. Apps are kept in a sorted map, so when several apps close
## at once their thaws come out in the same order every time.
##
## rust: pub enum Action { Foreground(String), Background(String), Freeze(String), Thaw(String) }
## rust: struct App { hidden_since: Option<i64>, frozen: bool }
## rust: pub struct Policy { after: i64, apps: BTreeMap<String, App> }
## rust: impl Policy

## A policy that freezes an app once it has been hidden for `after_ms`.
## rust: pub fn new(after_ms: u64) -> Self
export fn new(after_ms) = {after: after_ms, apps: [].to_dict()}

## `open`: the apps with windows; `visible`: the one on screen, if any (none at home or on the
## lock screen). The actions to apply, in order.
## rust: pub fn update(&mut self, now_ms: u64, open: &[String], visible: Option<&str>) -> Vec<Action>
export fn update(self, now_ms, open, visible) = do {
  # Closed apps: thaw any left frozen, so they can finish exiting.
  thaws = self.apps.items().filter((e) => e[1].frozen and not open.contains(e[0])).map((e) => {Thaw: e[0]})
  kept = self.apps.items().filter((e) => open.contains(e[0])).to_dict()
  done = open.reduce((kept, thaws), (acc, id) => see(acc, self.after, now_ms, visible, id))
  ({...self, apps: done[0]}, done[1])
}

## One open app, against the apps so far and the actions so far.
## rust: fn see(acc: (BTreeMap<String, App>, Vec<Action>), after: i64, now: i64, visible: Option<String>, id: String) -> (BTreeMap<String, App>, Vec<Action>)
fn see(acc, after, now, visible, id) = do {
  app = acc[0].get(id) ?? {hidden_since: missing, frozen: false}
  next = if on_screen(visible, id) then shown(app, id) else hidden(app, after, now, id)
  (acc[0].insert(id, next[0]), acc[1].concat(next[1]))
}

## rust: fn on_screen(visible: Option<String>, id: String) -> bool
fn on_screen(visible, id) = if visible.is_missing() then false else visible == id

## On screen: thawed at once, and back to the usual share if it had been hidden.
## rust: fn shown(app: App, id: String) -> (App, Vec<Action>)
fn shown(app, id) = do {
  thaw = if app.frozen then [{Thaw: id}] else []
  share = if app.hidden_since.is_missing() then [] else [{Foreground: id}]
  ({hidden_since: missing, frozen: false}, thaw.concat(share))
}

## Hidden: a small share from the moment it is hidden, and frozen once the wait is over. A
## clock that went backwards counts as no time passing, as `Instant::duration_since` does.
## rust: fn hidden(app: App, after: i64, now: i64, id: String) -> (App, Vec<Action>)
fn hidden(app, after, now, id) = if app.frozen then (app, []) else do {
  since = app.hidden_since ?? now
  share = if app.hidden_since.is_missing() then [{Background: id}] else []
  due = max(now - since, 0) >= after
  ({hidden_since: since, frozen: due}, if due then share.concat([{Freeze: id}]) else share)
}

## When the next app is due to be frozen.
## rust: pub fn next_deadline(&self) -> Option<u64>
export fn next_deadline(self) = do {
  waiting = self.apps.values().filter((a) => not a.frozen and not a.hidden_since.is_missing()).map((a) => a.hidden_since ?? 0)
  if waiting.count() == 0 then missing else waiting.min() + self.after
}

## `id` couldn't or mustn't be frozen now (it's playing, or has no unit yet): try again after
## another wait.
## rust: pub fn not_frozen(&mut self, id: &str, now_ms: u64)
export fn not_frozen(self, id, now_ms) = do {
  app = self.apps.get(id)
  if app.is_missing() then self else {...self, apps: self.apps.insert(id, {hidden_since: now_ms, frozen: false})}
}

## `id` is about to be brought forward or closed: thaw it now, and give it the usual wait if it
## stays hidden. True if it was frozen.
## rust: pub fn thaw(&mut self, id: &str, now_ms: u64) -> bool
export fn thaw(self, id, now_ms) = do {
  app = self.apps.get(id)
  if app.is_missing() then (self, false) else ({...self, apps: self.apps.insert(id, {hidden_since: now_ms, frozen: false})}, app.frozen)
}
