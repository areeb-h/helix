# Genomic annotations as DataFrames — GFF features and BED intervals flow through
# the same verbs as any other table. (Variants live in `variants.helix`.)

# GFF3: standard feature columns (seqid/source/type/start/end/score/strand/phase)
# plus one column per attribute tag (ID, Name, biotype, ...).
genes = bio.read_gff("examples/data/genes.gff3")
print("gene features:")
print(genes.where(@type == "gene").select(@seqid, @start, @end, @strand, @Name))

# BED: chrom/start/end, with name/score/strand surfaced because the file carries
# them. `score` is numeric, so it filters as a number.
peaks = bio.read_bed("examples/data/peaks.bed")
print("strong peaks (score > 400):")
print(peaks.where(@score > 400).select(@chrom, @start, @end, @name, @score))
