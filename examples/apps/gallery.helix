# The component gallery — every component of `ui` in one app (ADR 0055 Phase 2).
#
#   helix run examples/apps/gallery.helix             # then open the link it prints
#   helix run examples/apps/gallery.helix --open      # …or let it open your browser
#   helix run examples/apps/gallery.helix --window    # …or its own window (a `desktop` build)
#   helix run examples/apps/gallery.helix --replay    # a scripted session, as HTML
#
# It is also the design system's test bench: `tests/ui/gallery.mjs` drives it in Chromium,
# checks every state with axe-core in light and dark, and screenshots it.

import std.ui

ROWS = 10000
GROUPS = ["alpha", "beta", "gamma", "delta", "epsilon"]

# --- Data. --------------------------------------------------------------------------------

# Ten thousand rows for the virtualised table: the browser only ever holds a screenful.
fn table_data() = do {
  noise = randn(ROWS, 11)
  dataframe({
    id: range(1, ROWS + 1),
    sample: range(0, ROWS).map((i) => "S-{100000 + i * 7919 % 900000}"),
    group: range(0, ROWS).map((i) => GROUPS[i * 31 % 5]),
    value: range(0, ROWS).map((i) => 50.0 + 12.0 * noise[i]),
    passed: range(0, ROWS).map((i) => noise[i] > -1.0),
  })
}
TABLE = table_data()

fn series(seed) = do {
  x = linspace(0.0, 12.0, 49)
  phase = seed * 0.7
  [
    {name: "signal", xs: x, ys: x.map((t) => 2.0 * sin(t * 0.8 + phase) + 0.25 * t)},
    {name: "trend", xs: x, ys: x.map((t) => 0.25 * t + cos(t * 0.4 + phase))},
  ]
}
fn cloud(seed) = do {
  a = randn(80, seed)
  b = randn(80, seed + 100)
  {xs: a, ys: range(0, 80).map((i) => 0.6 * a[i] + 0.8 * b[i])}
}
fn counts(seed) = do {
  r = random(5, seed)
  range(0, 5).map((i) => round(20.0 + 80.0 * r[i]))
}

# --- The model. ---------------------------------------------------------------------------

PEOPLE = ["Ada Lovelace", "Grace Hopper", "Linus Torvalds", "Margaret Hamilton", "Alan Turing", "Barbara Liskov"]
ITEMS = [["Q3 report.pdf", "doc", "2.4 MB"], ["Launch hero.png", "image", "840 KB"], ["Budget.csv", "table", "96 KB"], ["Designs", "folder", "14 items"]]

# A small project, for the tree.
TREE = [
  {key: "src", label: "src", children: [
    {key: "src/ui", label: "ui", children: [{key: "src/ui/button.helix", label: "button.helix", icon: "code"}, {key: "src/ui/sheet.helix", label: "sheet.helix", icon: "code"}]},
    {key: "src/app.helix", label: "app.helix", icon: "code"},
  ]},
  {key: "docs", label: "docs", children: [{key: "docs/guide.md", label: "Guide.md", icon: "doc"}, {key: "docs/logo.png", label: "logo.png", icon: "image"}]},
  {key: "README.md", label: "README.md", icon: "doc"},
]
TASKS = {design: "Design the sheet", build: "Build the gestures", test: "Test on a phone", ship: "Ship it"}
MAIL = [
  {from: "Ada Lovelace", subject: "Notes on the engine", body: "The engine might compose elaborate pieces of music of any degree of complexity."},
  {from: "Grace Hopper", subject: "A bug, found", body: "First actual case of a bug being found — a moth, taped into the log book."},
  {from: "Margaret Hamilton", subject: "Priority displays", body: "The software recognised the overload and kept only the most important jobs running."},
]
ALBUMS = [["Coast", 200], ["Desert", 40], ["Forest", 140], ["Dusk", 300]]
NOTES = {n1: ["Build finished", "main passed in 4 min"], n2: ["Review requested", "Ada wants your eyes on #29"], n3: ["New comment", "“Ship it” — Grace"], n4: ["Disk almost full", "92% of 512 GB used"]}
COLUMNS = [
  {id: "todo", title: "To do", items: [{key: "c1", title: "Sketch the board", subtitle: "Design"}, {key: "c2", title: "Write the ADR", subtitle: "Docs"}]},
  {id: "doing", title: "Doing", items: [{key: "c3", title: "Cross-column drags", subtitle: "Engine"}]},
  {id: "done", title: "Done", items: [{key: "c4", title: "Swipe actions", subtitle: "Engine"}]},
]
SLIDES = [["Springs", "Every movement carries its velocity.", 260], ["Gestures", "The page drags; the app decides.", 160], ["Materials", "Glass where things float.", 30], ["Access", "Every gesture has a key.", 330]]
fn toggled(xs, x) = if xs.contains(x) then xs.filter((y) => y != x) else xs.concat([x])

fn design_for(m) = ui.design({seed: m.accent, material: m.material, shape: m.shape})

init0 = {
  material: "hybrid", shape: "soft", accent: "#4f46e5",
  view: "list", filter: "all", digest: "weekly", copies: 2, sheet: false, picked: 0, items: [0, 1, 2, 3],
  dark: false,
  tab: "account",
  name: "", email: "", bio: "", plan: "pro", agree: false, notify: true, volume: 40,
  submitted: false,
  menu: false, dialog: false,
  toasts: [], next: 1,
  offset: 0,
  seed: 1,
  last: "nothing yet",
  mail: [], album: -1,
  swiped: "", notes: ["n1", "n2", "n3", "n4"], columns: COLUMNS, slide: 0, bell: 0, like: false, gear: 0,
  split: 240, order: ["design", "build", "test", "ship"], open: ["src"], file: "src/app.helix", sections: ["motion"], pop: false, dense: false,
}
init = {...init0, design: design_for(init0)}

fn toast(m, text, tone, action = missing) = {...m, toasts: m.toasts.concat([if action.is_missing() then {id: m.next, text: text, tone: tone, born: missing} else {id: m.next, text: text, tone: tone, action: action, born: missing}]), next: m.next + 1}

fn errors(m) = {
  name: ui.check(m.name, [ui.required("Enter your name."), ui.min_length(2, "A name has at least two letters.")]),
  email: ui.check(m.email, [ui.required("Enter an email address."), ui.pattern("""^[^@\s]+@[^@\s]+\.[^@\s]+$""", "That doesn't look like an email address.")]),
  agree: if m.agree then missing else "Accept the terms to continue.",
}
fn valid(m) = do {
  e = errors(m)
  e.name.is_missing() and e.email.is_missing() and e.agree.is_missing()
}

fn update(m, e) = match e.msg {
  "material" => do {
    n = {...m, material: e.value}
    {...n, design: design_for(n)}
  },
  "shape" => do {
    n = {...m, shape: e.value}
    {...n, design: design_for(n)}
  },
  "view" => {...m, view: e.value},
  "filter" => {...m, filter: e.value},
  "digest" => {...m, digest: e.value},
  "copies" => {...m, copies: to_int(e.value)},
  "pick-item" => {...m, picked: to_int(e.value)},
  "open-sheet" => {...m, sheet: true},
  "close-sheet" => {...m, sheet: false},
  "remove" => if not m.items.contains(m.picked) then m else toast({...m, items: m.items.filter((i) => i != m.picked)}, "Removed “{ITEMS[m.picked][0]}”.", "neutral", {label: "Undo", msg: "restore", value: "{m.picked}"}),
  "restore" => {...m, items: m.items.concat([to_int(e.value)]).sort(), toasts: m.toasts.filter((t) => t.get("action").is_missing())},
  "theme" => {...m, dark: not m.dark},
  "tab" => {...m, tab: e.value},
  "name" => {...m, name: e.value},
  "email" => {...m, email: e.value},
  "bio" => {...m, bio: e.value},
  "plan" => {...m, plan: e.value},
  "agree" => {...m, agree: e.value},
  "notify" => {...m, notify: e.value},
  "volume" => {...m, volume: e.value},
  "submit" => if valid(m) then toast({...m, submitted: true}, "Saved — welcome, {m.name}.", "success") else {...m, submitted: true},
  "reset" => {...init, dark: m.dark, toasts: m.toasts, next: m.next},
  "menu" => {...m, menu: not m.menu},
  "pick" => toast({...m, menu: false, last: e.value}, "Chose “{e.value}”.", "accent"),
  "open-dialog" => {...m, dialog: true},
  "close-dialog" => {...m, dialog: false},
  "confirm" => toast({...m, dialog: false}, "Deleted 3 drafts.", "danger"),
  "toast" => toast(m, "A toast, number {m.next}.", "neutral"),
  "dismiss" => {...m, toasts: m.toasts.filter((t) => "{t.id}" != e.value)},
  "scroll" => {...m, offset: e.value},
  "reshuffle" => {...m, seed: m.seed + 1},
  "split" => {...m, split: ui.resized(e.value, 160, 420, m.split)},
  "order" => {...m, order: ui.reordered(m.order, e.value, (k) => k)},
  "tree-toggle" => {...m, open: toggled(m.open, e.value)},
  "tree-select" => {...m, file: e.value},
  "section" => {...m, sections: toggled(m.sections, e.value)},
  "pop" => {...m, pop: not m.pop},
  "dense" => {...m, dense: e.value},
  "open-mail" => {...m, mail: [to_int(e.value)]},
  "mail-back" => {...m, mail: m.mail.take(max(m.mail.count() - 1, 0))},
  "album" => {...m, album: to_int(e.value)},
  "album-close" => {...m, album: -1},
  "swipe" => {...m, swiped: ui.swiped(m.swiped, e, 2)},
  "archive" => toast({...m, notes: m.notes.filter((k) => k != e.value), swiped: ""}, "Archived “{(NOTES.get(e.value) ?? ["it"])[0]}”.", "neutral"),
  "delete-note" => {...m, notes: m.notes.filter((k) => k != e.value), swiped: ""},
  "card" => {...m, columns: ui.moved_between(m.columns, e.value)},
  "bin" => {...m, columns: m.columns.map((c) => {...c, items: c.items.filter((x) => x.key != "{e.get("dropped")}")})},
  "slide" => {...m, slide: e.value},
  "bell" => {...m, bell: m.bell + 1},
  "like" => {...m, like: not m.like},
  "gear" => {...m, gear: m.gear + 1},
  # Toasts expire five seconds after the first tick that sees them.
  "tick" => {...m, toasts: m.toasts.map((t) => if t.born.is_missing() then {...t, born: e.value} else t).filter((t) => e.value - t.born < 5.0)},
  _ => m,
}

# --- The view. ----------------------------------------------------------------------------

fn header(m) = ui.el("header", {class: "top"}, [
  ui.el("div", {}, [ui.heading("Components"), ui.label("Every component of ui.helix — built in Helix, rendered and diffed in Rust, animated on the compositor.")]),
  ui.el("div", {class: "actions"}, [
    ui.segmented("material", "Material", m.material, [["tonal", "Tonal"], ["hybrid", "Hybrid"], ["glass", "Glass"]], "material", size: "sm"),
    ui.segmented("shape", "Shape", m.shape, [["sharp", "Sharp"], ["soft", "Soft"], ["round", "Round"]], "shape", size: "sm"),
    ui.menu("actions", "Actions", m.menu, "menu", [
      {label: "Duplicate", msg: "pick", value: "Duplicate"},
      {label: "Rename", msg: "pick", value: "Rename"},
      {label: "Archive", msg: "pick", value: "Archive"},
    ]),
    ui.toggle("dark", "Dark", m.dark, "theme"),
  ]),
])

fn buttons(m) = ui.card("Buttons", [
  ui.cluster([ui.button("Default", "toast"), ui.button("Primary", "toast", variant: "primary"), ui.button("Ghost", "toast", variant: "ghost"), ui.button("Delete…", "open-dialog", variant: "danger")], gap: 2),
  ui.cluster([
    ui.button("Disabled", "toast", disabled: true),
    ui.tooltip("tip-copy", "Copy the link", ui.icon_button("⧉", "Copy link", "toast")),
    ui.tooltip("tip-more", "More options", ui.icon_button("⋯", "More options", "toast")),
    ], gap: 2),
  ui.cluster([ui.badge("Neutral"), ui.badge("Accent", tone: "accent"), ui.badge("Passed", tone: "success"), ui.badge("Pending", tone: "warning"), ui.badge("Failed", tone: "danger")], gap: 2),
])

fn account(m) = do {
  e = errors(m)
  show = (field) => if m.submitted then field else missing
  ui.form("submit", [
    ui.text_input("name", "Name", m.name, "name", error: show(e.name)),
    ui.text_input("email", "Email", m.email, "email", kind: "email", hint: "We only use it to sign you in.", error: show(e.email), placeholder: "ada@example.com"),
    ui.select("plan", "Plan", m.plan, [["free", "Free"], ["pro", "Pro — $8/month"], ["team", "Team — $20/seat"]], "plan"),
    ui.textarea("bio", "About you", m.bio, "bio", rows: 3, hint: "{m.bio.count()} / 160 characters", error: if m.bio.count() > 160 then "Keep it under 160 characters." else missing),
    ui.checkbox("agree", "I accept the terms", m.agree, "agree"),
    ui.el("p", {class: "error-line"}, [ui.text(if m.submitted and not e.agree.is_missing() then e.agree else "")]),
    ui.cluster([ui.submit_button("Save"), ui.button("Reset", "reset", variant: "ghost")], gap: 2),
  ])
}

fn preferences(m) = ui.column([
  ui.toggle("notify", "Email me about new releases", m.notify, "notify"),
  ui.el("div", {class: "field"}, [ui.el("span", {class: "field-label"}, [ui.text("Volume — {m.volume}%")]), ui.slider("volume", 0, 100, m.volume, label: "Volume")]),
  ui.progress("Volume", m.volume, max: 100.0),
  ], gap: 3)

fn about(m) = ui.column([
  ui.paragraph("Tabs are a tablist: arrow keys, Home and End move between them, and only the selected tab is in the Tab order. Every panel is rendered; the others are hidden."),
  ui.paragraph("Last menu choice: {m.last}."),
  ], gap: 3)

fn forms(m) = ui.card("Forms, tabs and validation", [
  ui.tabs("settings", m.tab, [
    {id: "account", label: "Account", content: account(m)},
    {id: "preferences", label: "Preferences", content: preferences(m)},
    {id: "about", label: "About", content: about(m)},
    ], "tab", label: "Settings"),
])

fn feedback(m) = ui.card("Feedback and overlays", [
  ui.paragraph("Toasts arrive in a polite live region and leave after five seconds; the rest glide into place. The dialog is the platform's modal <dialog>: it traps focus and gives it back."),
  ui.cluster([ui.button("Show a toast", "toast", variant: "primary"), ui.button("Open dialog", "open-dialog")], gap: 2),
  ui.stat("Toasts showing", "{m.toasts.count()}"),
  ui.stat("Menu", if m.menu then "open" else "closed"),
])

fn data(m) = ui.card("Data — {ROWS} rows, virtualised", [
  ui.paragraph("Only the rows in view (and a few either side) exist in the page; scrolling reports an offset and Helix sends the new window."),
  ui.data_table("samples", TABLE, m.offset, "scroll", "Samples", height: 320),
])

fn charts(m) = do {
  c = cloud(m.seed)
  ui.card("Charts", [
    ui.cluster([ui.button("Reshuffle data", "reshuffle"), ui.label("seed {m.seed}")], gap: 3),
    ui.grid([
      ui.line_chart("Signal and trend over time", series(m.seed)),
      ui.scatter_chart("Eighty correlated points", c.xs, c.ys),
      ui.bar_chart("Samples per group", GROUPS, counts(m.seed)),
      ], min: 460),
  ])
}

fn choices(m) = ui.card("Choices and status", [
  ui.el("div", {class: "field"}, [ui.el("span", {class: "field-label"}, [ui.text("View")]), ui.segmented("view", "View", m.view, [["list", "List"], ["grid", "Grid"], ["board", "Board"]], "view")]),
  ui.chips("filter", "Filter", m.filter, [["all", "All"], ["docs", "Documents"], ["images", "Images"]], "filter"),
  ui.radio_group("digest", "Digest", m.digest, [["daily", "Daily"], ["weekly", "Weekly"], ["never", "Never"]], "digest"),
  ui.toggle("sync", "Auto-sync", m.notify, "notify", hint: "Keep files up to date"),
  ui.el("div", {class: "between"}, [ui.el("span", {class: "field-label"}, [ui.text("Copies")]), ui.stepper("copies", "copies", m.copies, "copies", lo: 1, hi: 5)]),
  ui.el("div", {class: "between"}, [ui.avatars(PEOPLE, max: 4), ui.ring("Upload", m.volume)]),
  ui.skeleton(3),
])

fn lists(m) = ui.card("Lists, sheets and summaries", [
  ui.grid([ui.stat_tile("Shipped", "128", delta: "+12%", series: [3, 5, 4, 6, 8, 7, 9, 11]), ui.stat_tile("Blocked", "3", delta: "−2", trend: "down", series: [9, 8, 8, 6, 7, 5, 4, 3])], min: 140, gap: 3),
  if m.items.count() == 0 then ui.empty_state("folder", "Nothing left", "Undo brings them back.")
    else ui.list(m.items.map((i) => ui.list_item(ITEMS[i][0], subtitle: ITEMS[i][2], leading: ui.icon(ITEMS[i][1]), selected: m.picked == i, click: "pick-item", value: "{i}", key: "item-{i}")), label: "Files"),
  ui.cluster([ui.button("Share…", "open-sheet", variant: "tonal", icon: "share"), ui.button("Remove", "remove", variant: "outline", icon: "trash")], gap: 2),
  ui.sheet("share", m.sheet, "Share “{ITEMS[m.picked][0]}”", [
    ui.search_field("invite", "Add people", "", "noop", placeholder: "Add people or groups"),
    ui.list(range(0, 3).map((i) => ui.list_item(PEOPLE[i], subtitle: if i == 0 then "Owner" else "Can edit", leading: ui.avatar(PEOPLE[i]), key: "p{i}")), label: "People"),
    ], "close-sheet", actions: [ui.button("Cancel", "close-sheet", variant: "ghost"), ui.button("Send", "close-sheet", variant: "primary")]),
])

fn gestures(m) = ui.card("Gestures and structure", [
  ui.paragraph("Drag the divider, a task's grip, a toast sideways or the share sheet's grabber down. Each follows the pointer on the page and springs to where the app puts it, at the speed it was let go."),
  ui.el("div", {class: "split-demo inset-box"}, [ui.split_view(
    ui.tree("files-tree", "Project", TREE, m.open, m.file, "tree-toggle", "tree-select"),
    ui.accordion([
      {id: "motion", title: "Motion", subtitle: "springs", content: ui.paragraph("Every movement is a spring that carries its velocity, on the compositor.")},
      {id: "gestures", title: "Gestures", content: ui.paragraph("A drag is the page's; the outcome is the app's, decided in `update`.")},
      {id: "access", title: "Accessibility", content: ui.paragraph("Every gesture has a keyboard path: the divider's arrows, Alt with ↑ ↓ on a task, the tree's arrows.")},
      ], m.sections, "section"),
    m.split, "split", min: 160, max: 420, label: "Resize the project pane")]),
  ui.el("p", {class: "meta"}, [ui.text("Selected: {m.file} · pane {m.split} px")]),
  ui.sortable("tasks", "Tasks, in order", m.order.map((k) => {key: k, title: TASKS.get(k), subtitle: "#{m.order.index_of(k) + 1}"}), "order"),
  ui.cluster([
    ui.popover("view-options", "View options", m.pop, "pop", ui.column([ui.toggle("dense", "Compact rows", m.dense, "dense"), ui.paragraph("A popover holds anything, and gives focus back when it closes.")], gap: 2)),
    ui.spinner("Syncing"), ui.el("div", {class: "grow"}, [ui.progress("Indexing", missing)]),
    ], gap: 3),
])

fn album_tile(i) = ui.el("button", {class: "album-tile", key: "tile-{i}", share: "album-{i}", click: "album", value: "{i}", enter: "pop", style: {__hue: "{ALBUMS[i][1]}"}, attrs: {type: "button"}}, [
  ui.el("span", {class: "album-name"}, [ui.text(ALBUMS[i][0])]),
])
fn album_open(i) = ui.el("div", {class: "album-open", key: "open-{i}", share: "album-{i}", style: {__hue: "{ALBUMS[i][1]}"}, role: "group", aria: {label: ALBUMS[i][0]}}, [
  ui.el("div", {class: "album-hero"}, [ui.el("h3", {class: "album-title"}, [ui.text(ALBUMS[i][0])]), ui.icon_button("close", "Close {ALBUMS[i][0]}", "album-close")]),
  ui.paragraph("Opened in place: the tile grew into this card, its corners and position carried by one spring, and nothing in it stretched."),
])

fn navigation(m) = ui.card("Navigation and motion", [
  ui.paragraph("Open a message and swipe it back from its left edge. Open an album: the tile becomes the card. Close it and the tiles cascade back."),
  ui.grid([
    ui.stack("mail", [{key: "inbox", title: "Inbox", content: ui.list(range(0, MAIL.count()).map((i) => ui.list_item(MAIL[i].subject, subtitle: MAIL[i].from, leading: ui.avatar(MAIL[i].from), click: "open-mail", value: "{i}", key: "mail-{i}")), label: "Messages")}]
        .concat(m.mail.map((i) => {key: "msg-{i}", title: MAIL[i].subject, content: ui.column([ui.el("div", {class: "between"}, [ui.el("strong", {}, [ui.text(MAIL[i].from)]), ui.label("Today")]), ui.paragraph(MAIL[i].body)], gap: 2)})), "mail-back"),
    ui.el("div", {class: "albums"}, if m.album < 0 then range(0, ALBUMS.count()).map(album_tile) else [album_open(m.album)]),
    ], min: 300, gap: 4),
])

fn note_row(m, k) = ui.swipe_row(k, ui.el("div", {class: "li"}, [
  ui.el("span", {class: "li-lead"}, [ui.icon("bell")]),
  ui.el("span", {class: "two-line"}, [ui.el("span", {class: "li-title"}, [ui.text(NOTES.get(k)[0])]), ui.el("span", {class: "meta"}, [ui.text(NOTES.get(k)[1])])]),
  ]), [{label: "Archive", msg: "archive", value: k, icon: "archive", tone: "accent"}, {label: "Delete", msg: "delete-note", value: k, icon: "trash", tone: "danger"}], m.swiped, "swipe")

fn slide(s) = ui.el("div", {class: "slide", style: {__hue: "{s[2]}"}}, [ui.el("h3", {class: "slide-title"}, [ui.text(s[0])]), ui.el("p", {class: "slide-text"}, [ui.text(s[1])])])

fn rich(m) = ui.card("Rich interactions", [
  ui.paragraph("Swipe a row toward the start for its actions. Flick through the slides. Drag cards between columns, or onto the bin. Press the symbols."),
  ui.grid([
    ui.column([ui.subheading("Swipe actions"), if m.notes.count() == 0 then ui.empty_state("bell", "All caught up") else ui.swipe_list("Notifications", m.notes.map((k) => note_row(m, k)))], gap: 2),
    ui.column([ui.subheading("Carousel"), ui.carousel("tour", "Tour", SLIDES.map(slide), "slide"), ui.el("p", {class: "meta"}, [ui.text("Showing slide {m.slide + 1} of {SLIDES.count()}")])], gap: 2),
    ], min: 300, gap: 4),
  ui.subheading("A board"),
  ui.board("plan", "Plan", m.columns, "card"),
  ui.el("div", {class: "bin", drop: "bin", value: "bin", role: "group", aria: {label: "Bin: drop a card here to remove it"}}, [ui.icon("trash"), ui.el("span", {}, [ui.text("Drop a card here to remove it")])]),
  ui.subheading("Symbols"),
  ui.cluster([
    ui.el("button", {class: "btn tonal", click: "bell", attrs: {type: "button"}}, [ui.symbol("bell", "bounce", m.bell, size: "sm"), ui.text("Notify ({m.bell})")]),
    ui.el("button", {class: "btn tonal", click: "like", aria: {pressed: m.like}, attrs: {type: "button"}}, [ui.symbol(if m.like then "sparkle" else "heart", "swap", if m.like then 1 else 0, size: "sm"), ui.text(if m.like then "Liked" else "Like")]),
    ui.el("button", {class: "btn tonal", click: "gear", attrs: {type: "button"}}, [ui.symbol("settings", "wiggle", m.gear, size: "sm"), ui.text("Settings")]),
    ], gap: 2),
])

fn view(m) = ui.column([
  header(m),
  ui.grid([buttons(m), feedback(m)], min: 380),
  ui.grid([choices(m), lists(m)], min: 380),
  gestures(m),
  navigation(m),
  rich(m),
  forms(m),
  charts(m),
  data(m),
  ui.dialog("confirm-delete", m.dialog, "Delete drafts?", [ui.paragraph("Three drafts will be deleted. This cannot be undone.")], "close-dialog", actions: [ui.button("Cancel", "close-dialog", variant: "ghost"), ui.button("Delete", "confirm", variant: "danger")]),
  ui.toasts(m.toasts, "dismiss"),
  ], gap: 5)

STYLE = """
.top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s-4); flex-wrap: wrap; }
.actions { display: flex; gap: var(--s-4); align-items: center; }
.error-line { margin: 0; min-height: 0; color: var(--danger); font-size: var(--t-sm); font-weight: 500; }
.error-line:empty { display: none; }
.between { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); }
.inset-box { border-radius: var(--r-in-card); background: var(--surface-2); padding: var(--s-2); }
.split-demo .split { height: 260px; }
.split-demo .split-pane { padding: var(--s-1); }
.grow { flex: 1; min-width: 160px; }
#mail { min-height: 300px; }
.albums { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-2); align-content: start; min-height: 300px; }
.album-tile { --tone: oklch(.62 .14 var(--hue)); border: 0; border-radius: var(--r-in-card); min-height: 140px; padding: var(--s-3); display: flex; align-items: flex-end; cursor: pointer;
  background: linear-gradient(150deg, oklch(.55 .13 var(--hue)), oklch(.4 .14 calc(var(--hue) + 30))); color: #fff; font: var(--type-headline); text-align: left; }
.album-name { text-shadow: 0 1px 8px rgba(0, 0, 0, .35); }
.album-open { grid-column: 1 / -1; border-radius: var(--r-in-card); overflow: hidden; background: var(--surface-2); min-height: 300px; display: flex; flex-direction: column; }
.album-hero { min-height: 180px; display: flex; align-items: flex-end; justify-content: space-between; padding: var(--s-3); color: #fff;
  background: linear-gradient(150deg, oklch(.55 .13 var(--hue)), oklch(.4 .14 calc(var(--hue) + 30))); }
.album-hero .btn { color: #fff; }
.album-title { margin: 0; font: var(--type-title-1); letter-spacing: var(--track-title-1); text-shadow: 0 1px 8px rgba(0, 0, 0, .35); }
.album-open .para { padding: var(--s-3); margin: 0; }
.slide { min-height: 170px; border-radius: var(--r-in-card); padding: var(--s-4); display: flex; flex-direction: column; justify-content: flex-end; color: #fff;
  background: linear-gradient(150deg, oklch(.55 .13 var(--hue)), oklch(.4 .14 calc(var(--hue) + 40))); }
.slide-title { margin: 0; font: var(--type-title-2); letter-spacing: var(--track-title-2); }
.slide-text { margin: 4px 0 0; opacity: .92; }
.bin { display: flex; align-items: center; justify-content: center; gap: var(--s-2); min-height: 56px; border-radius: var(--r-in-card); border: 1.5px dashed var(--line-strong); color: var(--muted); }
"""

spec = {
  title: "Component gallery",
  init: init,
  update: update,
  view: view,
  style: STYLE,
  design: (m) => m.design,
  theme: (m) => if m.dark then "dark" else "light",
  subscriptions: (m) => if m.toasts.count() == 0 then [] else [ui.every(1000, "tick")],
}

# A scripted session: a failed submit, a fix, a successful one, the menu, the dialog, a toast
# expiring, a scroll through the table and the theme. One screen per event.
SESSION = [
  {msg: "submit", value: missing},
  {msg: "name", value: "Ada"},
  {msg: "email", value: "ada@example.com"},
  {msg: "agree", value: true},
  {msg: "submit", value: missing},
  {msg: "menu", value: missing},
  {msg: "pick", value: "Archive"},
  {msg: "open-dialog", value: missing},
  {msg: "confirm", value: missing},
  {msg: "tick", value: 100.0},
  {msg: "tick", value: 106.0},
  {msg: "tab", value: "preferences"},
  {msg: "volume", value: 75},
  {msg: "scroll", value: 36000},
  {msg: "reshuffle", value: missing},
  {msg: "theme", value: missing},
  {msg: "split", value: 300},
  {msg: "order", value: {key: "test", from: 2, to: 0}},
  {msg: "order", value: {key: "nope", from: 0, to: 3}},
  {msg: "tree-toggle", value: "docs"},
  {msg: "tree-select", value: "docs/guide.md"},
  {msg: "section", value: "gestures"},
  {msg: "pop", value: missing},
  {msg: "open-mail", value: "1"},
  {msg: "album", value: "2"},
  {msg: "mail-back", value: missing},
  {msg: "album-close", value: missing},
  {msg: "swipe", value: "n2", drag: {dx: -120, dy: 0, vx: -400, vy: 0}},
  {msg: "card", value: {key: "c1", from: 0, to: 1, from_list: "todo", to_list: "doing"}},
  {msg: "bin", value: "bin", dropped: "c4"},
  {msg: "bell", value: missing},
]

fn main(port: Int = 8080, open: Bool = false, window: Bool = false, replay: Bool = false) = if replay then ui.replay(spec, SESSION).map((html) => print(html)) else ui.app({...spec, port: port, open: open, window: window})
