# Pattern matching — `match` tries each arm in order; the first matching pattern
# binds its variables and yields its result. It is an expression, like `if`.

# Literal patterns, an or-pattern (`a | b | c`), and a `_` wildcard fallback.
fn classify(n) = match n {
  0 => "zero",
  1 | 2 | 3 => "a few",
  _ => "many",
}
print(classify(0))
print(classify(2))
print(classify(7))

# A binding pattern captures the value; a guard (`if ...`) refines an arm; arms recurse.
fn polarity(n) = match n {
  0 => "zero",
  x if x > 0 => "positive",
  _ => "negative",
}
print(polarity(0))
print(polarity(5))
print(polarity(-3))

fn fib(n) = match n {
  0 => 0,
  1 => 1,
  _ => fib(n - 1) + fib(n - 2),
}
print(fib(10))

# `missing` is a pattern — pattern matching pairs naturally with the missing model.
fn describe(x) = match x {
  missing => "no value",
  _ => "got a value",
}
print(describe(missing))
print(describe(42))

# A range pattern classifies by magnitude: `lo..hi` matches lo up to but NOT
# including hi — the same half-open convention as `range(lo, hi)` and `xs[lo:hi]`, so
# adjacent bands tile exactly and nothing lands in two of them. This is the shape that
# would otherwise be a ladder of `else if`.
fn class_name(code) = match code {
  100..200 => "informational",
  200..300 => "success",
  300..400 => "redirect",
  400..500 => "client error",
  500..600 => "server error",
  _ => "unknown",
}
print(class_name(204))
print(class_name(404))
print(class_name(700))

# Tuple and record patterns destructure nested data...
print(match (1, (2, 3)) { (a, (b, c)) => a + b + c, _ => 0 })

# ...and the natural fit: destructuring a `try` result, no `.ok`/`.value` plumbing.
fn safe_div(a, b) = match try (a / b) {
  {ok: true, value: v} => v,
  {ok: false} => 0,
}
print(safe_div(10, 2))
print(safe_div(10, 0))
