# String interpolation + the `??` missing-default operator.
#   helix examples/strings.helix
#
## There are four string forms, and the only thing that varies is the DELIMITER and
## whether interpolation happens. `'...'` and `"..."` are the same string:
##
##     >>> 'hi'
##     hi
##     >>> 'a' == "a"
##     true
##
## Having both means the quote you are NOT delimited by needs no escaping. That matters
## most inside an interpolation hole, which is where escaped quotes used to pile up:
##
##     >>> "-> {if true then 'YES' else 'NO'}"
##     -> YES
##     >>> 'he said "hi"'
##     he said "hi"
##
## `'''...'''` spans lines AND interpolates — use it for a report or a banner:
##
##     >>> who = "Ada"
##     >>> '''hello {who}'''
##     hello Ada
##
## `"""..."""` also spans lines but is RAW: no interpolation, no `\` escapes. That is what
## you want for CSS, JSON, regexes and Windows paths, which are full of braces and
## backslashes that would otherwise need doubling:
##
##     >>> """{1 + 1}"""
##     {1 + 1}
##
## So: pick the quote that avoids escaping, and pick the triple by whether you want the
## braces interpreted or left alone.
#
# Any string interpolates `{expr}` (no `f` prefix). Use `{{` / `}}` for literal
# braces. Embedded expressions are type-checked at compile time, like everything.

name = "Ada"
age = 41
print("Hello {name}, you are {age}.")

# Any expression works inside the braces — calls, arithmetic, even `if`:
xs = [3, 1, 4, 1, 5, 9]
print("mean {xs.mean()}, max {xs.max()}, n {xs.count()}")
print("{age} in 10 years is {age + 10}")
print("grade: {if xs.mean() > 3 then "pass" else "fail"}")

# Literal braces:
print("a set looks like {{1, 2, 3}}")

# `??` supplies a default when a value is `missing` (best-of-TypeScript):
timeout = missing
print("timeout = {timeout ?? 30}")
print("present = {age ?? 0}")

# Composes with functions and chains:
fn greet(who) = "Hi {who}!"
print(greet("Helix"))
print([1, 2, 3].map(it * it).map("sq={it}"))

## `chars()` turns a string into an array of one-character strings, so the whole array
## vocabulary — `map`, `filter`, `reduce`, `enumerate` — applies to text:
##
##     >>> "hello".chars()
##     ["h", "e", "l", "l", "o"]
##     >>> "hello".chars().filter(it != "l").count()
##     3
##
## It counts Unicode scalars, the same unit as `count`, `reverse`, `take` and `drop`:
##
##     >>> "héllo".chars().count()
##     5
print("chars:", "hello".chars())
