# A cooperative event-loop HTTP server: one thread serves many keep-alive connections
# interleaved, so no client can pin the server (unlike a blocking accept→respond loop).
#   helix run examples/api/event_server.helix   # then: curl http://127.0.0.1:8080/
#
# Measured ~83k req/s on one core (~1.7x the blocking conn-per-request server), zero
# starvation, and ~0.3% CPU when idle — because `wait` blocks in poll(2) until a
# connection is ready rather than busy-spinning. The loop is tail-recursive, so it runs
# in constant space (TCO). For the simple case, the blocking accept/respond loop is fine;
# reach for this when you need concurrent keep-alive throughput.
#
# The primitives:
#   l.accept_poll()          non-blocking accept -> a persistent keep-alive connection (or missing)
#   l.wait(conns, ms)        block until the listener or any connection is readable (or timeout)
#   conn.poll_request()      non-blocking: the next request on this connection, or missing
#   conn.is_open()           whether the connection is still open
#   conn.respond(resp)       reply, keeping the connection open for the next request

fn handle(req) = {status: 200, text: "hello from the event loop\n"}

# One tick: wait for readiness, accept any new connection, then serve every connection that
# has a request ready — dropping the ones that have closed. Tail-recursive => constant space.
fn loop(l, conns) = do {
  ready = l.wait(conns, 50)
  fresh = l.accept_poll()
  live = if fresh.is_missing() then conns else conns.concat([fresh])
  active = live.filter(c => do {
    req = c.poll_request()
    if req.is_missing() then c.is_open()          # not ready (keep) or closed (drop)
      else do {
        sent = c.respond(handle(req))               # served — keep the connection alive
        c.is_open()
      }
  })
  loop(l, active)
}

l = listen(8080)
elog("event-loop server on http://127.0.0.1:8080")
loop(l, [])
