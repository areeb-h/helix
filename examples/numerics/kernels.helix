# Native kernels — the numeric core. Helix compiles pure numeric comprehensions
# and scalar functions to native code (Cranelift JIT) and runs array work across
# cores, so idiomatic Helix reaches C-class speed WITHOUT you writing a loop, a
# type annotation, or a parallel directive. Every result here is bit-identical on
# all three engines — the JIT is an optimization, never a different answer.
#   helix run examples/numerics/kernels.helix
#
# Timings below are from a 6-core laptop; run it yourself with `time`.

n = 5000000

# --- 1. Reductions over a range fuse into ONE native loop ---
# No intermediate array is built: `map` + `filter` + `reduce` become a single
# pass, so this touches memory once.
total = range(0, n)
  .map(i => i * 2)
  .filter(it % 3 == 0)
  .reduce(0, (acc, x) => acc + x)
print("fused sum:      ", total)

# --- 2. Element-wise array math is data-parallel across cores ---
xs = range(0, n).map(i => (i % 97) * 1.0)
ys = range(0, n).map(i => (i % 89) * 1.0)
print("built arrays:   ", xs.count(), "elements each")

# --- 3. A dot product: array reads inside a reduce become native loads ---
# `xs[j]` inside the kernel compiles to a direct memory load; bounds are checked
# ONCE before the loop, not per element.
dot = range(0, n).reduce(0.0, (acc, j) => acc + xs[j] * ys[j])
print("dot product:    ", dot)

# --- 4. Scalar functions JIT too — including recursive ones ---
# A tail-recursive scalar function becomes a native loop (no stack growth):
fn collatz_len(k, steps) =
  if k == 1 then steps
  else collatz_len(if k % 2 == 0 then k // 2 else 3 * k + 1, steps + 1)

# ...and calling it from a comprehension keeps everything native:
longest = range(1, 100000).map(k => collatz_len(k, 0)).max()
print("longest collatz:", longest)

# --- 5. Functions mixing Float and Int params get a native loop, unannotated ---
# The annotations below are DOCUMENTATION, not a requirement: the JIT infers each
# parameter's kind from how the body uses it, so deleting every `: Float` and
# `: Int` here changes neither the answer nor the speed (measured: same result,
# 0.15s vs 0.16s, both native). They were once load-bearing — the mixed
# specialization was reachable only through an explicit annotation, which made the
# natural spelling of a numeric loop 53x slower — and that is exactly why they are
# no longer needed. Annotate for readers, not for the compiler.
fn escape(zr: Float, zi: Float, cr: Float, ci: Float, i: Int) =
  if i >= 50 then i
  else if (zr * zr + zi * zi) > 4.0 then i
  else escape(zr * zr - zi * zi + cr, 2.0 * zr * zi + ci, cr, ci, i + 1)

mandel = range(0, 200)
  .map(y => range(0, 200)
      .map(x => escape(0.0, 0.0, (x * 1.0) * 0.015 - 2.1, (y * 1.0) * 0.015 - 1.5, 0))
      .sum())
  .sum()
print("mandelbrot sum: ", mandel)

# --- 6. Delegating to a real library beats a clever loop ---
# Tensors route to a BLAS-class GEMM; a sieve is a native builtin. Helix's job is
# to pick the right implementation, not to make you hand-roll one.
a = zeros([200, 200]) + 1.5
b = zeros([200, 200]) + 2.0
print("matmul[0,0]:    ", a.matmul(b)[0][0])
print("primes < 1e6:   ", primes(1000000).count())
