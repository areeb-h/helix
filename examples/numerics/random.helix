# Reproducible random numbers — seeded and pure, so the same seed always gives the
# same draws (great for experiments you need to reproduce).
#   helix run examples/random.helix

# Constructors (free functions): n draws from an explicit seed.
print("uniforms:", random(5, 42))            # 5 doubles in [0, 1)
print("normals:", randn(5, 42))              # 5 standard-normal N(0, 1) draws
print("dice:", random_int(8, 1, 7, 42))      # 8 integers in [1, 7)

# Reproducibility: identical seed → identical output.
print("reproducible:", random(3, 7) == random(3, 7))

# Sampling methods on an array.
deck = range(1, 11)
print("shuffled:", deck.shuffle(1))          # a random permutation
print("hand:", deck.sample(3, 2))            # 3 distinct cards, no replacement
print("pick:", deck.choice(3))               # one random element

# A typical experiment: a noisy linear relationship y = 2x + ε.
xs = random(6, 100)
noise = randn(6, 200)
ys = xs.enumerate().map((i, x) => 2.0 * x + 0.1 * noise[i])
print("noisy line:", ys)
print("fit slope ~2:", linear_regression(xs, ys).slope)
