# Exact rationals — arbitrary-precision fractions that never drift.
#
# `rational(n, d)` builds an exact fraction, always reduced to lowest terms.
# Arithmetic (+ - * / **) stays exact forever: the partner to gcd/lll when you
# need PSLQ-style exact coefficients instead of floating-point approximations.

# The headline: floats lose 1/3 + 1/3 + 1/3; rationals do not.
third = rational(1, 3)
print("float thirds:   ", 1.0 / 3.0 + 1.0 / 3.0 + 1.0 / 3.0)   # 0.9999999999999999
print("rational thirds:", third + third + third)               # 1

# Construction reduces automatically; integer-valued fractions print as integers.
print("4/8 reduces to", rational(4, 8))                        # 1/2
print("6/3 is the integer", rational(6, 3))                    # 2

# All four operations are exact.
print("1/2 + 1/3 =", rational(1, 2) + rational(1, 3))          # 5/6
print("2/3 * 3/4 =", rational(2, 3) * rational(3, 4))          # 1/2
print("3/4 / 2/3 =", rational(3, 4) / rational(2, 3))          # 9/8
print("(2/3)^3   =", rational(2, 3) ** 3)                      # 8/27
print("(3/5)^-2  =", rational(3, 5) ** (0 - 2))                # 25/9

# Mixing with an Int stays exact; mixing with a Float intentionally drops to Float.
print("1/2 + 5  =", rational(1, 2) + 5)                        # 11/2
print("1/2 + 0.1 =", rational(1, 2) + 0.1)                     # 0.6

# Exact comparison and equality (3/6 and 1/2 are the same number).
print("1/3 < 1/2:", rational(1, 3) < rational(1, 2))           # true
print("3/6 == 1/2:", rational(3, 6) == rational(1, 2))         # true

# Arbitrary precision — these denominators overflow 64-bit integers.
print("tiny sum:", rational(1, 1000000000) + rational(1, 3000000000))   # 1/750000000

# Accessors and an explicit bridge back to Float.
approx = rational(355, 113)                                # a famous pi approximation
print("numerator:", numerator(approx), " denominator:", denominator(approx))
print("as float:", to_float(approx))                           # 3.1415929...

# Exact summation over an array: fold with `reduce` to keep every bit.
parts = [rational(1, 2), rational(1, 3), rational(1, 6)]
print("exact total:", parts.reduce(rational(0, 1), (acc, x) => acc + x))   # 1
print("sorted:", parts.sort())                                 # [1/6, 1/3, 1/2]
