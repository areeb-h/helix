# Reverse-mode automatic differentiation — gradients of any computation, and the
# gradient descent it powers. `variable(x)` wraps a number/tensor as a tracked leaf;
# the ops you apply record a graph; `gradient(loss, x)` backpropagates through it.

# --- gradients with known answers ---
x = variable(3.0)
print("d(x^2)/dx at 3:", gradient(x * x, x))                 # 2x = 6
s = variable(0.0)
print("d(sigmoid)/ds at 0:", gradient(sigmoid(s), s))        # 0.25

# gradient of a vector reduction: d/dv sum(v^2) = 2v
v = variable(tensor([1.0, 2.0, 3.0]))
print("grad sum(v^2):", gradient((v * v).sum(), v))          # [2, 4, 6]

# gradient w.r.t. several parameters at once → one per parameter
a = variable(2.0)
b = variable(5.0)
print("grad of a*b wrt [a,b]:", gradient(a * b, [a, b]))     # [b, a] = [5, 2]

# --- the payoff: train linear regression y = 2x + 1 by gradient descent ---
# Features carry a bias column, so the weights to learn are [slope, intercept].
X = tensor([[1.0, 1.0], [2.0, 1.0], [3.0, 1.0], [4.0, 1.0], [5.0, 1.0]])
y = tensor([3.0, 5.0, 7.0, 9.0, 11.0])                       # exactly 2x + 1

# One gradient-descent step: wrap the weights, build the loss, follow -gradient.
fn step(w) = do {
  wv = variable(w)
  loss = ((X.matmul(wv) - y) ** 2).mean()                    # mean squared error
  w - 0.03 * gradient(loss, wv)                              # plain-tensor SGD update
}
fn mse(w) = value_of(((X.matmul(variable(w)) - y) ** 2).mean())

start = tensor([0.0, 0.0])
print("\nstart loss:", mse(start))
w1 = range(0, 200).reduce(start, (w, i) => step(w))
print("loss after 200 steps:", mse(w1))
trained = range(0, 800).reduce(w1, (w, i) => step(w))
print("loss after 1000 steps:", mse(trained))
print("learned weights (≈ [2, 1]):", trained)

# --- the scalars→tensor bridge: individual parameters, one BLAS matmul ---
# Above, the whole weight vector is one `variable`. When parameters are named
# separately — the shape a layer usually has — `tensor(…)` assembles them into a
# real tensor that is still on the tape, so the forward pass is a `matmul` and the
# gradient still finds each scalar. A plain element is simply a constant.
w11 = variable(0.5)
w12 = variable(-0.5)
w21 = variable(0.25)
w22 = variable(0.75)
W = tensor([[w11, w12], [w21, w22]])                         # tracked 2×2
out = W.matmul(tensor([1.0, 2.0])).sum()
print("\nlayer out:", value_of(out))                         # 1.25
print("d out/d each weight:", gradient(out, [w11, w12, w21, w22]))  # [1, 2, 1, 2]

# Reading a tracked tensor apart keeps the pieces tracked: an element scatters its
# gradient back where it came from, and a slice gathers rows the same way.
print("W[0][1] =", value_of(W[0][1]), "→ d/dw12 =", gradient(W[0][1], w12))
print("first row sum grad wrt w11:", gradient(W[0:1].sum(), w11))
print("shape:", W.shape(), "count:", W.count())              # metadata, not calculus
