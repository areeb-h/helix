# DataFrames — the marquee Phase 3 feature. Run from the project root:
#   helix examples/dataframes.helix
#
# Backed by Polars (Arrow columnar, lazy). The SAME `where`/`sort` verbs you use
# on arrays work here — `where(@age > 40)` lowers to a native Polars filter.
#
# Columns are written with the `@` sigil: `@age` is *always* the `age` column,
# never a variable of the same name — so a column and a local can never be
# confused, and an editor can autocomplete columns the moment you type `@`.

patients = read_csv("examples/data/patients.csv")

print("columns:", patients.columns())
print("rows:", patients.count())

# SQL-intuitive query: filter, pick columns, sort — reads top to bottom.
older = patients
  .where(@age > 40)
  .select(@name, @age, @diagnosis)
  .sort(@age)
print(older)

# Predicates compose with `and`/`or` and arithmetic, just like everywhere else.
print(patients.where(@age > 40 and @resting_hr < 75))

# Derived columns: `with` adds (or replaces) columns computed over existing ones.
print(patients.with({adult: @age >= 18, hr_per_decade: @resting_hr / (@age / 10)}))

# Grouping: one obvious verb, then an aggregation.
genes = read_csv("examples/data/genes.csv")
print(genes.group(@species).mean(@expression))

# Joining: combine two frames on a shared key column. Defaults to an inner join;
# a trailing string ("left"/"right"/"outer") selects another join type.
samples = read_csv("examples/data/samples.csv")
meta = read_csv("examples/data/sample_meta.csv")
print(samples.join(meta, @sample_id).sort(@sample_id))
